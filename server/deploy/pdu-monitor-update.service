[Unit]
Description=Update PDU Monitor from its git clone (started by pdu-monitor-update.path)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# root, on purpose: it replaces /usr/local/bin/pdumonitord and restarts the service. The web process only leaves a file; nothing in the
# file is read as a command. Not part of pdu-monitor.service, so restarting that does not stop the update.
ExecStart=/usr/local/sbin/pdu-update server
TimeoutStartSec=900
# No sandboxing here, on purpose: this job is root anyway, and Go installed with snap does not run under NoNewPrivileges, RestrictNamespaces or
# a read-only /sys ("cannot change profile for the next exec call: Operation not permitted").
